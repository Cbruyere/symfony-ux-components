{
    "name": "chrisdev/ux-components",
    "description": "Reusable Symfony UX components by ChrisDev.",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ChrisDev\\UxComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisDev\\UxComponents\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/ux-live-component": "^3.1",
        "symfony/ux-twig-component": "^3.1"
    },
    "require-dev": {
        "doctrine/orm": "^3.6",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "zenstruck/foundry": "^2.10",
        "symfony/orm-pack": "^2.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3"
    },
    "suggest": {
        "doctrine/orm": "To use DoctrineDataSource as a DataTable source",
        "symfony/security-bundle": "To enable authentication-aware navbar items"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}