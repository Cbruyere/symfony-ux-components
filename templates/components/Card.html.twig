{# templates/components/Card.html.twig #}
<div
	class="flex flex-col bg-slate-900 border border-slate-800 shadow-2xs rounded-xl overflow-hidden">
	{# Image section - only render if image is provided #}
	{% if image %}
		<div class="w-full h-auto">
			<img class="w-full h-auto rounded-t-xl" src="{{ image }}" alt="Card Image">
		</div>
	{% endif %}

	{# Content section #}
	<div
		class="p-4 sm:p-5">
		{# Title - only render if provided #}
		{% if title %}
			<h3 class="font-semibold text-white">
				{{ title }}
			</h3>
		{% endif %}

		{# Content - slot for main content #}
		<div class="mt-2">
			{% block content %}{% endblock %}
		</div>

		{# Button - only render if buttonLabel is provided #}
		{% if buttonLabel %}
			<div class="mt-4">
				<a href="{{ buttonAction }}" class="inline-flex items-center justify-center gap-x-2 text-sm font-medium rounded-lg bg-blue-600 border border-blue-600 text-white hover:bg-blue-500 focus:outline-hidden focus:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none py-2 px-3">
					{{ buttonLabel }}
				</a>
			</div>
		{% endif %}
	</div>
</div>
