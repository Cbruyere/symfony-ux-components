<div
    id="{{ id }}"
    class="relative"
    data-hs-carousel="{{ this.options|json_encode }}"
>
    <div class="hs-carousel relative min-h-80 w-full overflow-hidden rounded-lg border border-slate-800 bg-slate-900">
        <div class="hs-carousel-body absolute bottom-0 start-0 top-0 flex flex-nowrap opacity-0 transition-transform duration-700">
            {% for item in items %}
                <div class="hs-carousel-slide">
                    <div class="relative h-full">
                        {% if item.image is defined and item.image %}
                            <img
                                class="h-full w-full object-cover"
                                src="{{ item.image }}"
                                alt="{{ item.alt|default(item.title|default('Carousel image')) }}"
                            >
                        {% endif %}

                        <div class="absolute inset-x-0 bottom-0 bg-slate-950/80 p-5 backdrop-blur">
                            {% if item.title is defined and item.title %}
                                <h3 class="text-lg font-semibold text-white">{{ item.title }}</h3>
                            {% endif %}

                            {% if item.description is defined and item.description %}
                                <p class="mt-2 max-w-2xl text-sm text-slate-300">{{ item.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {% if withControls %}
        <button
            type="button"
            class="hs-carousel-prev hs-carousel-disabled:cursor-default hs-carousel-disabled:opacity-50 absolute start-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-slate-950/80 text-white shadow-2xs hover:bg-slate-900 focus:outline-hidden"
        >
            <span class="text-2xl" aria-hidden="true">
                {{ ux_icon('bi:chevron-left', {class: 'size-5 shrink-0'}) }}
            </span>
            <span class="sr-only">Previous</span>
        </button>
        <button
            type="button"
            class="hs-carousel-next hs-carousel-disabled:cursor-default hs-carousel-disabled:opacity-50 absolute end-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-slate-950/80 text-white shadow-2xs hover:bg-slate-900 focus:outline-hidden"
        >
            <span class="sr-only">Next</span>
            <span class="text-2xl" aria-hidden="true">
                {{ ux_icon('bi:chevron-right', {class: 'size-5 shrink-0'}) }}
            </span>
        </button>
    {% endif %}

    {% if withIndicators %}
        <div class="hs-carousel-pagination absolute inset-x-0 bottom-3 flex justify-center gap-x-2"></div>
    {% endif %}
</div>
